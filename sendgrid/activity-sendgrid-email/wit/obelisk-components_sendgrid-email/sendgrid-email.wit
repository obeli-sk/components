package obelisk-components:sendgrid-email@0.1.0;

/// SendGrid Email API interface for sending emails.
interface email {
    /// An email address with optional display name.
    record email-address {
        /// The email address (e.g., "user@example.com")
        email: string,
        /// Optional display name (e.g., "John Doe")
        name: option<string>,
    }

    /// Content of an email body.
    record content {
        /// MIME type (e.g., "text/plain" or "text/html")
        mime-type: string,
        /// The actual content
        value: string,
    }

    /// A personalization block for SendGrid - allows different recipients per email.
    record personalization {
        /// Recipients (to)
        to: list<email-address>,
        /// CC recipients (optional)
        cc: option<list<email-address>>,
        /// BCC recipients (optional)
        bcc: option<list<email-address>>,
        /// Subject line override (optional)
        subject: option<string>,
    }

    /// Email attachment.
    record attachment {
        /// Base64-encoded content of the attachment
        content: string,
        /// Filename to display
        filename: string,
        /// MIME type (e.g., "application/pdf")
        mime-type: option<string>,
        /// Content disposition: "inline" or "attachment"
        disposition: option<string>,
        /// Content ID for inline attachments
        content-id: option<string>,
    }

    /// A complete email message.
    record email-message {
        /// Sender email address
        sender: email-address,
        /// Subject line
        subject: string,
        /// Personalizations (recipients and per-recipient settings)
        personalizations: list<personalization>,
        /// Email content (can include both plain text and HTML versions)
        content: list<content>,
        /// Optional reply-to address
        reply-to: option<email-address>,
        /// Optional attachments
        attachments: option<list<attachment>>,
    }

    /// Simple email parameters for basic use cases.
    record simple-email {
        /// Sender email address
        from-email: string,
        /// Optional sender display name
        from-name: option<string>,
        /// Recipient email address
        to-email: string,
        /// Optional recipient display name
        to-name: option<string>,
        /// Subject line
        subject: string,
        /// Plain text content (optional if html-content is provided)
        text-content: option<string>,
        /// HTML content (optional if text-content is provided)
        html-content: option<string>,
    }

    /// Error details from SendGrid API.
    record error-detail {
        /// Error message
        message: string,
        /// Field that caused the error (if applicable)
        field: option<string>,
    }

    /// Errors that can occur when sending email.
    variant send-error {
        /// Required for Obelisk - indicates timeout or trap in last retry.
        execution-failed,
        /// Configuration error (e.g., missing API key)
        configuration-error(string),
        /// Invalid request (e.g., malformed email address)
        validation-error(string),
        /// SendGrid API returned an error
        api-error(list<error-detail>),
        /// Network or HTTP error
        request-failed(string),
    }

    /// Response from a successful send operation.
    record send-response {
        /// The message ID assigned by SendGrid (from x-message-id header)
        message-id: option<string>,
    }

    /// Send a simple email (convenience function for basic use cases).
    /// Requires SENDGRID_API_KEY environment variable.
    send-simple: func(email: simple-email) -> result<send-response, send-error>;

    /// Send a full email message with all SendGrid options.
    /// Requires SENDGRID_API_KEY environment variable.
    send: func(message: email-message) -> result<send-response, send-error>;
}
